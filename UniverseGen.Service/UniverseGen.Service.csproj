<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UniverseGen.Service</AssemblyName>
    <RootNamespace>UniverseGen.Service</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Missing XML docs on internals aren't worth a warning each. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniverseGen\UniverseGen.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UniverseGen.Tests" />
    <InternalsVisibleTo Include="UniverseGen.Service.Http" />
  </ItemGroup>
</Project>
