<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UniverseGen</AssemblyName>
    <RootNamespace>UniverseGen</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The service rebuilds systems and chunks it receives over the wire, which have internal constructors. -->
    <InternalsVisibleTo Include="UniverseGen.Service" />
    <InternalsVisibleTo Include="UniverseGen.Tests" />
  </ItemGroup>
</Project>
