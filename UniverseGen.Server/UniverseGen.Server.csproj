<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>galgen-server</AssemblyName>
    <RootNamespace>UniverseGen.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UniverseGen.Service.Http\UniverseGen.Service.Http.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="galgen.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
